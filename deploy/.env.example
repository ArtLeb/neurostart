# Скопируйте файл как .env и замените все значения CHANGE_ME уникальными строками.
APP_ID=neurostart
APP_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

MYSQL_DATABASE=neurostart
MYSQL_USER=neurostart
MYSQL_PASSWORD=CHANGE_ME_USE_ANOTHER_RANDOM_HEX
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_THIRD_RANDOM_HEX

PUBLIC_APP_URL=https://ai.lebedevit.ru
CORS_ORIGINS=https://ai.lebedevit.ru
API_ONLY=true
PORT=3000

# Заполняются только на сервере при подключении реальной или тестовой ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
