# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── YooKassa (server-side only) ────────────────────────────────
YOOKASSA_SHOP_ID=          # Shop ID from the YooKassa merchant panel
YOOKASSA_SECRET_KEY=       # Secret key from the YooKassa merchant panel
YOOKASSA_VAT_CODE=1        # VAT code used in the receipt (confirm with your accountant)
PUBLIC_APP_URL=            # Public site origin, e.g. https://ai.lebedevit.ru
CORS_ORIGINS=              # Comma-separated allowed frontend origins, e.g. https://ai.lebedevit.ru
API_ONLY=false             # true disables static frontend serving for the split deployment
PORT=3000
